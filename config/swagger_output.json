    "/atendimento/{id}/iniciar": {
      "put": {
        "tags": [
          "Atendimentos"
        ],
        "summary": "Altera o status do atendimento para em_atendimento",
        "description": "Exclusivo para Veterinários. Retorna 400 se o atendimento já foi iniciado ou não está agendado.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do Atendimento"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Atendimento já está com este status"
          },
          "403": {
            "description": "Acesso negado: apenas Veterinários."
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
