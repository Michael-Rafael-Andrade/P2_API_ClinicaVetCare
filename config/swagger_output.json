    "/usuario/cadastro": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Mapeamento alternativo para cadastro de usuário",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NovoUsuario"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/usuario/login": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Autentica um usuário e retorna o Token JWT",
        "description": "",
