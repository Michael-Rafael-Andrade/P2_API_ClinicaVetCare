  "definitions": {
    "NovoUsuario": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "example": "Dr. Carlos Silva"
        },
        "usuario": {
          "type": "string",
          "example": "carlos_vet"
        },
        "senha": {
          "type": "string",
          "example": "senha123"
        },
        "perfil": {
          "type": "string",
          "example": "veterinario"
        }
      },
      "required": [
        "nome",
        "usuario",
        "senha"
      ]
    },
    "UsuarioResposta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "example": 1
        },
        "nome": {
          "type": "string",
          "example": "Dr. Carlos Silva"
        },
        "usuario": {
          "type": "string",
          "example": "carlos_vet"
        },
        "perfil": {
          "type": "string",
          "example": "veterinario"
        }
      }
    },
    "LoginUsuario": {
      "type": "object",
      "properties": {
        "usuario": {
          "type": "string",
          "example": "carlos_vet"
        },
        "senha": {
          "type": "string",
          "example": "senha123"
        }
      },
      "required": [
        "usuario",
        "senha"
      ]
    },
    "LoginResposta": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "usuario": {
          "type": "object",
          "properties": {
            "id": {
              "type": "number",
              "example": 1
            },
            "nome": {
              "type": "string",
              "example": "Dr. Carlos Silva"
            },
            "usuario": {
              "type": "string",
              "example": "carlos_vet"
            },
            "perfil": {
              "type": "string",
              "example": "veterinario"
            }
          }
        }
      }
    },
    "NovoPet": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "example": "Thor"
        },
        "especie": {
          "type": "string",
          "example": "Cachorro"
        }
      },
      "required": [
        "nome",
        "especie"
      ]
    },
    "PetResposta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "example": 1
        },
        "nome": {
          "type": "string",
          "example": "Thor"
        },
        "especie": {
          "type": "string",
          "example": "Cachorro"
        }
      }
    },
    "NovoAtendimento": {
      "type": "object",
      "properties": {
        "data_hora": {
          "type": "string",
          "example": "2026-06-14T14:30:00.000Z"
        },
        "motivo": {
          "type": "string",
          "example": "Consulta de rotina e vacinação"
        },
        "pet_id": {
          "type": "number",
          "example": 1
        }
      },
      "required": [
        "data_hora",
        "motivo",
        "pet_id"
      ]
    },
    "AtendimentoResposta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "example": 1
        },
        "data_hora": {
          "type": "string",
          "example": "2026-06-14T14:30:00.000Z"
        },
        "motivo": {
          "type": "string",
          "example": "Consulta de rotina e vacinação"
        },
        "status": {
          "type": "string",
          "example": "agendado"
        },
        "pet_id": {
          "type": "number",
          "example": 1
        },
        "usuario_id": {
          "type": "number",
          "example": 4
        },
        "criada_em": {
          "type": "string",
          "example": "2026-06-14T01:45:19.000Z"
        },
        "atualizada_em": {
          "type": "string",
          "example": "2026-06-14T01:45:19.000Z"
        }
      }
    },
    "AtualizarStatusAtendimento": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "em_atendimento"
        }
      },
      "required": [
        "status"
      ]
    }
  }
