{
  "swagger": "2.0",
  "info": {
    "title": "VetCare API",
    "version": "1.0.0",
    "description": "API RESTful para gerenciamento de atendimentos veterinários com autenticação JWT (Avaliação Prática 02)"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Informe o token JWT no formato: Bearer <seu_token>"
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Index"
        ],
        "summary": "Página ou endpoint inicial da VetCare API",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/pet/": {
      "get": {
        "tags": [
          "Pets"
        ],
        "summary": "Lista todos os pets cadastrados",
        "description": "Disponível para qualquer perfil autenticado. Resposta armazenada em cache por 30 segundos.",
        "responses": {
          "200": {
            "description": "Lista obtida com sucesso.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Pet"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Não autenticado: Token inválido ou ausente."
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Pets"
        ],
        "summary": "Cadastra um novo pet no sistema",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Dados do pet",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NovoPet"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Acesso negado."
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/pet/{id}": {
      "get": {
        "tags": [
          "Pets"
        ],
        "summary": "Exibe detalhes de um pet específico",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do Pet"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
